local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TableUtils = require(ReplicatedStorage.Std.TableUtils)
local PLAYER_DATA_CONSTANTS = {
	AUTO_SAVE_INTERVAL = 30,
	SEMAPHORE_SORTED_MAP_NUM_SHARDS = 20,
	TIMES_TO_RETRY_SEMAPHORE_OPERATION = 60,
	DELAY_BETWEEN_SEMAPHORE_OPERATION_RETRIES = 1,
	VEHICLE_ITEM_TYPE = "Vehicle",
	VEHICLE_CUSTOMIZATION_ITEM_TYPE = "VehicleCustomization",
	HOME_ITEM_ITEM_TYPE = "HomeItem",
	ITEM_SKIN_ITEM_TYPE = "ItemSkin",
	SAFE_ITEM_TYPE = "Safe",
	CONSUMABLE_ITEM_TYPE = "Consumable"
}
PLAYER_DATA_CONSTANTS.SEMAPHORE_EXPIRATION_TIME = PLAYER_DATA_CONSTANTS.AUTO_SAVE_INTERVAL * 2 + 60
PLAYER_DATA_CONSTANTS.FUNCTION_TYPES = {
	"Defaults",
	PLAYER_DATA_CONSTANTS.VEHICLE_ITEM_TYPE,
	PLAYER_DATA_CONSTANTS.VEHICLE_CUSTOMIZATION_ITEM_TYPE,
	PLAYER_DATA_CONSTANTS.HOME_ITEM_ITEM_TYPE,
	PLAYER_DATA_CONSTANTS.ITEM_SKIN_ITEM_TYPE,
	PLAYER_DATA_CONSTANTS.SAFE_ITEM_TYPE,
	PLAYER_DATA_CONSTANTS.CONSUMABLE_ITEM_TYPE
}
PLAYER_DATA_CONSTANTS.FUNCTION_TYPE_TO_INDEX = {}
for i, itemType in ipairs(PLAYER_DATA_CONSTANTS.FUNCTION_TYPES) do
	PLAYER_DATA_CONSTANTS.FUNCTION_TYPE_TO_INDEX[itemType] = i
end
PLAYER_DATA_CONSTANTS.ITEM_TYPE_SET = {}
for i, itemType in ipairs(PLAYER_DATA_CONSTANTS.FUNCTION_TYPES) do
	if itemType ~= "Defaults" then
		PLAYER_DATA_CONSTANTS.ITEM_TYPE_SET[itemType] = true
	end
end
return TableUtils.requireValidIndexAndFreeze(PLAYER_DATA_CONSTANTS)
