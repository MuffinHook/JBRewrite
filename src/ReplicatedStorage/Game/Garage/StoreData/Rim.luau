    GetInstance = function(arg1) -- Line 2, Named "GetInstance"
        --[[ Upvalues[1]:
            [1]: ReplicatedStorage_upvr (readonly)
        ]]
        local SOME = ReplicatedStorage_upvr.Resource.Rims:FindFirstChild(arg1.Name)
        if not SOME then
            error("No Rim named: "..arg1.Name)
        end
        local clone = SOME:Clone()
        clone.Color = Color3.new(0.5, 0.5, 0.5)
        clone.CFrame = CFrame.new(0, 0, 0)
        clone.Size = clone.Size.Unit * 4
        if arg1.FlipY then
            clone.CFrame *= CFrame.Angles(0, math.pi, 0)
        end
        if arg1.VisualFlipY then
            clone.CFrame *= CFrame.Angles(0, math.pi, 0)
        end
        return clone
    end;
    Update = function(arg1, arg2) -- Line 20, Named "Update"
        local var4 = os.clock() / 2
        arg1.CFrame = CFrame.Angles(0, var4 % (-math.pi*2), 0) * CFrame.Angles(math.sin(var4) * 0.5, 0, 0) * CFrame.new(0, 0, 3)
    end;
