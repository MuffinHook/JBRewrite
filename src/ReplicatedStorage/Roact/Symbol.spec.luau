-- Reviewed by Claude
return function()
	local Symbol = require(script.Parent.Symbol)
	describe("named", function()
 it("should give an opaque object", function()
 expect((Symbol.named("foo"))).to.be.a("userdata")
 end)
 it("should coerce to the given name", function()
 expect((tostring((Symbol.named("foo"))):find("foo"))).to.be.ok()
 end)
 it("should be unique when constructed", function()
 local typeSymbol = Symbol.named("abc")
 local typeSymbol2 = Symbol.named("abc")
 expect(typeSymbol).never.to.equal(typeSymbol2)
 end)
	end)
end