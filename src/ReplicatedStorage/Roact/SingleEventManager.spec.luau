-- Reviewed by Claude
return function()
	local assertDeepEqual = require(script.Parent.assertDeepEqual)
	local createSpy = require(script.Parent.createSpy)
	local Logging = require(script.Parent.Logging)
	local SingleEventManager = require(script.Parent.SingleEventManager)
	describe("new", function()
 it("should create a SingleEventManager", function()
 expect((SingleEventManager.new())).to.be.ok()
 end)
	end)
	describe("connectEvent", function()
 it("should connect to events", function()
 local v1 = Instance.new("BindableEvent")
 local v2 = SingleEventManager.new(v1)
 local fn = createSpy()
 v2:connectEvent("Event", fn.value)
 v2:resume()
 v1:Fire("foo")
 expect(fn.callCount).to.equal(1)
 fn:assertCalledWith(v1, "foo")
 v1:Fire("bar")
 expect(fn.callCount).to.equal(2)
 fn:assertCalledWith(v1, "bar")
 v2:connectEvent("Event", nil)
 v1:Fire("baz")
 expect(fn.callCount).to.equal(2)
 end)
 it("should drop events until resumed initially", function()
 local v1 = Instance.new("BindableEvent")
 local v2 = SingleEventManager.new(v1)
 local fn = createSpy()
 v2:connectEvent("Event", fn.value)
 v1:Fire("foo")
 expect(fn.callCount).to.equal(0)
 v2:resume()
 v1:Fire("bar")
 expect(fn.callCount).to.equal(1)
 fn:assertCalledWith(v1, "bar")
 end)
 it("should invoke suspended events when resumed", function()
 local v1 = Instance.new("BindableEvent")
 local v2 = SingleEventManager.new(v1)
 local fn = createSpy()
 v2:connectEvent("Event", fn.value)
 v2:resume()
 v1:Fire("foo")
 expect(fn.callCount).to.equal(1)
 fn:assertCalledWith(v1, "foo")
 v2:suspend()
 v1:Fire("bar")
 expect(fn.callCount).to.equal(1)
 v2:resume()
 expect(fn.callCount).to.equal(2)
 fn:assertCalledWith(v1, "bar")
 end)
 it("should invoke events triggered during resumption in the correct order", function()
 local v1 = Instance.new("BindableEvent")
 local v2 = SingleEventManager.new(v1)
 local tbl = {}
 local fn = createSpy(function(p1, p2)
 table.insert(tbl, p2)
 if p2 == 2 then
 v1:Fire(3)
 elseif p2 == 3 then
 v1:Fire(4)
 end
 end)
 v2:connectEvent("Event", fn.value)
 v2:suspend()
 v1:Fire(1)
 v1:Fire(2)
 v2:resume()
 expect(fn.callCount).to.equal(4)
 assertDeepEqual(tbl, { 1, 2, 3, 4 })
 end)
 it("should not invoke events fired during suspension but disconnected before resumption", function()
 local v1 = Instance.new("BindableEvent")
 local v2 = SingleEventManager.new(v1)
 local fn = createSpy()
 v2:connectEvent("Event", fn.value)
 v2:suspend()
 v1:Fire(1)
 v2:connectEvent("Event", nil)
 v2:resume()
 expect(fn.callCount).to.equal(0)
 end)
 it("should not yield events through the SingleEventManager when resuming", function()
 local v1 = Instance.new("BindableEvent")
 local v2 = SingleEventManager.new(v1)
 v2:connectEvent("Event", function()
 coroutine.yield()
 end)
 v2:resume()
 local fn = coroutine.create(function()
 v1:Fire(5)
 end)
 assert(coroutine.resume(fn))
 expect(coroutine.status(fn)).to.equal("dead")
 v2:suspend()
 v1:Fire(5)
 local fn2 = coroutine.create(function()
 v2:resume()
 end)
 assert(coroutine.resume(fn2))
 expect(coroutine.status(fn2)).to.equal("dead")
 end)
 it("should not throw errors through SingleEventManager when resuming", function()
 local v1 = Instance.new("BindableEvent")
 local v2 = SingleEventManager.new(v1)
 v2:connectEvent("Event", function()
 error("Error from SingleEventManager test")
 end)
 v2:resume()
 v2:suspend()
 v1:Fire(5)
 local fn = Logging.capture(function()
 v2:resume()
 end)
 expect(#fn.errors).to.equal(0)
 expect(#fn.warnings).to.equal(1)
 expect(#fn.infos).to.equal(0)
 expect(fn.warnings[1]:find("Error from SingleEventManager test")).to.be.ok()
 end)
 it("should not overflow with events if manager:resume() is invoked when resuming a suspended event", function()
 local v1 = Instance.new("BindableEvent")
 local v2 = SingleEventManager.new(v1)
 local fn = createSpy(function(p1, p2)
 if p2 == 1 then
 v2:suspend()
 v1:Fire(2)
 v2:resume()
 end
 end)
 v2:connectEvent("Event", fn.value)
 v2:suspend()
 v1:Fire(1)
 v2:resume()
 expect(fn.callCount).to.equal(2)
 end)
	end)
	describe("connectPropertyChange", function()
 it("should connect to property changes", function()
 local baz = Instance.new("Folder")
 local v1 = SingleEventManager.new(baz)
 local v2 = createSpy()
 v1:connectPropertyChange("Name", v2.value)
 v1:resume()
 baz.Name = "foo"
 expect(v2.callCount).to.equal(1)
 v2:assertCalledWith(baz)
 baz.Name = "bar"
 expect(v2.callCount).to.equal(2)
 v2:assertCalledWith(baz)
 v1:connectPropertyChange("Name")
 baz.Name = "baz"
 expect(v2.callCount).to.equal(2)
 end)
 it("should throw an error if the property is invalid", function()
 local v2 = SingleEventManager.new((Instance.new("Folder")))
 expect(function()
 v2:connectPropertyChange("foo", function() end)
 end).to.throw()
 end)
	end)
end