-- Reviewed by Claude
return function()
	local createSpy = require(script.Parent.createSpy)
	describe("createSpy", function()
 it("should create spies", function()
 expect((createSpy(function() end))).to.be.ok()
 end)
 it("should throw if spies are indexed by an invalid key", function()
 local v1 = createSpy(function() end)
 expect(function()
 return v1.test
 end).to.throw()
 end)
	end)
	describe("value", function()
 it("should increment callCount when called", function()
 local v1 = createSpy(function() end)
 v1.value()
 expect(v1.callCount).to.equal(1)
 end)
 it("should store all values passed", function()
 local v1 = createSpy(function() end)
 v1.value(1, true, "3")
 expect(v1.valuesLength).to.equal(3)
 expect(v1.values[1]).to.equal(1)
 expect(v1.values[2]).to.equal(true)
 expect(v1.values[3]).to.equal("3")
 end)
 it("should return the value of the inner function", function()
 expect(createSpy(function()
 return true
 end).value()).to.equal(true)
 end)
	end)
	describe("assertCalledWith", function()
 it("should throw if the number of values differs", function()
 local v1 = createSpy(function() end)
 v1.value(1, 2)
 expect(function()
 v1:assertCalledWith(1)
 end).to.throw()
 end)
 it("should throw if any value differs", function()
 local v1 = createSpy(function() end)
 v1.value(1, 2)
 expect(function()
 v1:assertCalledWith(1, 3)
 end).to.throw()
 expect(function()
 v1:assertCalledWith(2, 3)
 end).to.throw()
 end)
	end)
	describe("captureValues", function()
 it("should throw if the number of values differs", function()
 local v1 = createSpy(function() end)
 v1.value(1, 2)
 expect(function()
 v1:captureValues("a")
 end).to.throw()
 end)
 it("should capture all values in a table", function()
 local v1 = createSpy(function() end)
 v1.value(1, 2)
 local v2 = v1:captureValues("a", "b")
 expect(v2.a).to.equal(1)
 expect(v2.b).to.equal(2)
 end)
	end)
end