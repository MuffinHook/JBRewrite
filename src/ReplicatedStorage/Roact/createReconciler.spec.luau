-- Reviewed by Claude
-- variables reassigned
return function()
	local assign = require(script.Parent.assign)
	local createElement = require(script.Parent.createElement)
	local createFragment = require(script.Parent.createFragment)
	local createSpy = require(script.Parent.createSpy)
	local NoopRenderer = require(script.Parent.NoopRenderer)
	local Type = require(script.Parent.Type)
	local ElementKind = require(script.Parent.ElementKind)
	local createReconciler = require(script.Parent.createReconciler)
	local var1 = createReconciler(NoopRenderer)
	describe("tree operations", function()
 it("should mount and unmount", function()
 local fn = var1.mountVirtualTree(createElement("StringValue"))
 expect(fn).to.be.ok()
 var1.unmountVirtualTree(fn)
 end)
 it("should mount, update, and unmount", function()
 local fn = var1.mountVirtualTree(createElement("StringValue"))
 expect(fn).to.be.ok()
 var1.updateVirtualTree(fn, createElement("StringValue"))
 var1.unmountVirtualTree(fn)
 end)
	end)
	describe("booleans", function()
 it("should mount booleans as nil", function()
 expect((var1.mountVirtualNode(false, nil, "test"))).to.equal(nil)
 end)
 it("should unmount nodes if they are updated to a boolean value", function()
 local fn = var1.mountVirtualNode(createElement("StringValue"), nil, "test")
 expect(fn).to.be.ok()
 expect((var1.updateVirtualNode(fn, true))).to.equal(nil)
 end)
	end)
	describe("invalid elements", function()
 it("should throw errors when attempting to mount invalid elements", function()
 local function f1()
 return "Hello"
 end
 local function f2()
 return 1
 end
 local function f3()
 return function() end
 end
 local function f4()
 return {}
 end
 expect(function()
 var1.mountVirtualNode(createElement(f1), nil, "Some Key")
 end).to.throw()
 expect(function()
 var1.mountVirtualNode(createElement(f2), nil, "Some Key")
 end).to.throw()
 expect(function()
 var1.mountVirtualNode(createElement(f3), nil, "Some Key")
 end).to.throw()
 expect(function()
 var1.mountVirtualNode(createElement(f4), nil, "Some Key")
 end).to.throw()
 end)
	end)
	describe("Host components", function()
 it("should invoke the renderer to mount host nodes", function()
 local var1 = createSpy(NoopRenderer.mountHostNode)
 local fn2 = createReconciler((assign({}, NoopRenderer, {
 mountHostNode = var1.value
 })))
 local currentState = fn2.mountVirtualNode(createElement("StringValue"), nil, "Some Key")
 expect(Type.of(currentState)).to.equal(Type.VirtualNode)
 expect(var1.callCount).to.equal(1)
 local nextState = var1:captureValues("reconciler", "node")
 expect(nextState.reconciler).to.equal(fn2)
 expect(nextState.node).to.equal(currentState)
 end)
 it("should invoke the renderer to update host nodes", function()
 local var1 = createSpy(NoopRenderer.updateHostNode)
 local fn2 = createReconciler((assign({}, NoopRenderer, {
 mountHostNode = NoopRenderer.mountHostNode,
 updateHostNode = var1.value
 })))
 local currentState = fn2.mountVirtualNode(createElement("StringValue"), nil, "Key")
 expect(Type.of(currentState)).to.equal(Type.VirtualNode)
 local nextState = createElement("StringValue")
 expect((fn2.updateVirtualNode(currentState, nextState))).to.equal(currentState)
 expect(var1.callCount).to.equal(1)
 local mergedState = var1:captureValues("reconciler", "node", "newElement")
 expect(mergedState.reconciler).to.equal(fn2)
 expect(mergedState.node).to.equal(currentState)
 expect(mergedState.newElement).to.equal(nextState)
 end)
 it("should invoke the renderer to unmount host nodes", function()
 local var1 = createSpy(NoopRenderer.unmountHostNode)
 local fn2 = createReconciler((assign({}, NoopRenderer, {
 mountHostNode = NoopRenderer.mountHostNode,
 unmountHostNode = var1.value
 })))
 local currentState = fn2.mountVirtualNode(createElement("StringValue"), nil, "Key")
 expect(Type.of(currentState)).to.equal(Type.VirtualNode)
 fn2.unmountVirtualNode(currentState)
 expect(var1.callCount).to.equal(1)
 local nextState = var1:captureValues("reconciler", "node")
 expect(nextState.reconciler).to.equal(fn2)
 expect(nextState.node).to.equal(currentState)
 end)
	end)
	describe("Function components", function()
 it("should mount and unmount function components", function()
 local fn = createSpy(function(self)
 return nil
 end)
 local fn3 = var1.mountVirtualNode(createElement(fn.value, {
 someValue = 5
 }), nil, "A Key")
 expect(Type.of(fn3)).to.equal(Type.VirtualNode)
 expect(fn.callCount).to.equal(1)
 local currentState = fn:captureValues("props")
 expect(currentState.props).to.be.a("table")
 expect(currentState.props.someValue).to.equal(5)
 var1.unmountVirtualNode(fn3)
 expect(fn.callCount).to.equal(1)
 end)
 it("should mount single children of function components", function()
 local fn = createSpy(function(self)
 return nil
 end)
 local fn2 = createSpy(function(self)
 return createElement(fn.value, {
 value = self.value + 1
 })
 end)
 local currentState = var1.mountVirtualNode(createElement(fn2.value, {
 value = 13
 }), nil, "A Key")
 expect(Type.of(currentState)).to.equal(Type.VirtualNode)
 expect(fn2.callCount).to.equal(1)
 expect(fn.callCount).to.equal(1)
 local nextState = fn2:captureValues("props")
 local tempState = fn:captureValues("props")
 expect(nextState.props).to.be.a("table")
 expect(nextState.props.value).to.equal(13)
 expect(tempState.props).to.be.a("table")
 expect(tempState.props.value).to.equal(14)
 var1.unmountVirtualNode(currentState)
 expect(fn2.callCount).to.equal(1)
 expect(fn.callCount).to.equal(1)
 end)
 it("should mount fragments returned by function components", function()
 local fn = createSpy(function(self)
 return nil
 end)
 local fn2 = createSpy(function(self)
 return nil
 end)
 local fn3 = createSpy(function(self)
 return createFragment({
 A = createElement(fn.value, {
 value = self.value + 1
 }),
 B = createElement(fn2.value, {
 value = self.value + 5
 })
 })
 end)
 local nextState = var1.mountVirtualNode(createElement(fn3.value, {
 value = 17
 }), nil, "A Key")
 expect(Type.of(nextState)).to.equal(Type.VirtualNode)
 expect(fn3.callCount).to.equal(1)
 expect(fn.callCount).to.equal(1)
 expect(fn2.callCount).to.equal(1)
 local tempState = fn3:captureValues("props")
 local mergedState = fn:captureValues("props")
 local updatedState = fn2:captureValues("props")
 expect(tempState.props).to.be.a("table")
 expect(tempState.props.value).to.equal(17)
 expect(mergedState.props).to.be.a("table")
 expect(mergedState.props.value).to.equal(18)
 expect(updatedState.props).to.be.a("table")
 expect(updatedState.props.value).to.equal(22)
 var1.unmountVirtualNode(nextState)
 expect(fn3.callCount).to.equal(1)
 expect(fn.callCount).to.equal(1)
 expect(fn2.callCount).to.equal(1)
 end)
	end)
	describe("Fragments", function()
 it("should mount fragments", function()
 local fn2 = var1.mountVirtualNode(createFragment({}), nil, "test")
 expect(fn2).to.be.ok()
 expect(ElementKind.of(fn2.currentElement)).to.equal(ElementKind.Fragment)
 end)
 it("should mount an empty fragment", function()
 local fn2 = var1.mountVirtualNode(createFragment({}), nil, "test")
 expect(fn2).to.be.ok()
 expect((next(fn2.children))).to.never.be.ok()
 end)
 it("should mount all fragment\'s children", function()
 local fn = createSpy(function(self)
 return nil
 end)
 local tableObj = {}
 for i = 1, 5 do
 tableObj["key" .. tostring(i)] = createElement(fn.value, {})
 end
 expect((var1.mountVirtualNode(createFragment(tableObj), nil, "test"))).to.be.ok()
 expect(fn.callCount).to.equal(5)
 end)
	end)
end
