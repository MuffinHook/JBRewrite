-- Reviewed by Claude
return function()
	local createSignal = require(script.Parent.createSignal)
	local createSpy = require(script.Parent.createSpy)
	it("should fire subscribers and disconnect them", function()
 local v1 = createSignal()
 local v2 = createSpy()
 local v3 = v1:subscribe(v2.value)
 expect(v2.callCount).to.equal(0)
 local tbl = {}
 v1:fire(1, tbl, "hello")
 expect(v2.callCount).to.equal(1)
 v2:assertCalledWith(1, tbl, "hello")
 v3()
 v1:fire()
 expect(v2.callCount).to.equal(1)
	end)
	it("should handle multiple subscribers", function()
 local v1 = createSignal()
 local v2 = createSpy()
 local v3 = createSpy()
 local fn = v1:subscribe(v2.value)
 local fn2 = v1:subscribe(v3.value)
 expect(v2.callCount).to.equal(0)
 expect(v3.callCount).to.equal(0)
 local tbl = {}
 v1:fire(tbl, 67)
 expect(v2.callCount).to.equal(1)
 v2:assertCalledWith(tbl, 67)
 expect(v3.callCount).to.equal(1)
 v3:assertCalledWith(tbl, 67)
 fn()
 v1:fire(67, tbl)
 expect(v2.callCount).to.equal(1)
 expect(v3.callCount).to.equal(2)
 v3:assertCalledWith(67, tbl)
 fn2()
	end)
	it("should stop firing a connection if disconnected mid-fire", function()
 local v1 = createSignal()
 local v2 = nil
 local v3 = nil
 local fn = createSpy(function()
 v3()
 end)
 local fn2 = createSpy(function()
 v2()
 end)
 v2 = v1:subscribe(fn.value)
 v3 = v1:subscribe(fn2.value)
 v1:fire()
 expect(fn.callCount + fn2.callCount).to.equal(1)
	end)
	it("should allow adding listener in the middle of firing", function()
 local v1 = createSignal()
 local v2 = nil
 local v3 = createSpy()
 local fn = v1:subscribe(function(p1, p2)
 v2 = v1:subscribe(v3.value)
 end)
 expect(v3.callCount).to.equal(0)
 local tbl = {}
 v1:fire(tbl, 67)
 expect(v3.callCount).to.equal(0)
 v1:fire(67, tbl)
 expect(v3.callCount).to.equal(1)
 v3:assertCalledWith(67, tbl)
 v2()
 fn()
 v1:fire(tbl)
 expect(v3.callCount).to.equal(1)
	end)
	it("should have one connection instance when add the same listener multiple times", function()
 local v1 = createSignal()
 local v2 = createSpy()
 local v3 = v1:subscribe(v2.value)
 expect(v2.callCount).to.equal(0)
 local tbl = {}
 v1:fire(tbl, 67)
 expect(v2.callCount).to.equal(1)
 v2:assertCalledWith(tbl, 67)
 local fn = v1:subscribe(v2.value)
 v1:fire(67, tbl)
 expect(v2.callCount).to.equal(2)
 v2:assertCalledWith(67, tbl)
 fn()
 v1:fire(tbl)
 expect(v2.callCount).to.equal(2)
 v3()
 v1:fire(tbl)
 expect(v2.callCount).to.equal(2)
	end)
end