-- Reviewed by Claude
return function()
	local createSignal = require(script.Parent.createSignal)
	local createSpy = require(script.Parent.createSpy)
	it("should fire subscribers and disconnect them", function()
 local v1 = createSignal()
 local v2 = createSpy()
 local v3 = v1:subscribe(v2.value)
 expect(v2.callCount).to.equal(0)
 local t = {}
 v1:fire(1, t, "hello")
 expect(v2.callCount).to.equal(1)
 v2:assertCalledWith(1, t, "hello")
 v3()
 v1:fire()
 expect(v2.callCount).to.equal(1)
	end)
	it("should handle multiple subscribers", function()
 local v1 = createSignal()
 local v2 = createSpy()
 local v3 = createSpy()
 local v4 = v1:subscribe(v2.value)
 local v5 = v1:subscribe(v3.value)
 expect(v2.callCount).to.equal(0)
 expect(v3.callCount).to.equal(0)
 local t = {}
 v1:fire(t, 67)
 expect(v2.callCount).to.equal(1)
 v2:assertCalledWith(t, 67)
 expect(v3.callCount).to.equal(1)
 v3:assertCalledWith(t, 67)
 v4()
 v1:fire(67, t)
 expect(v2.callCount).to.equal(1)
 expect(v3.callCount).to.equal(2)
 v3:assertCalledWith(67, t)
 v5()
	end)
	it("should stop firing a connection if disconnected mid-fire", function()
 local v1 = createSignal()
 local v2 = nil
 local v3 = nil
 local v4 = createSpy(function()
 v3()
 end)
 local v5 = createSpy(function()
 v2()
 end)
 v2 = v1:subscribe(v4.value)
 v3 = v1:subscribe(v5.value)
 v1:fire()
 expect(v4.callCount + v5.callCount).to.equal(1)
	end)
	it("should allow adding listener in the middle of firing", function()
 local v1 = createSignal()
 local v2 = nil
 local v3 = createSpy()
 local v4 = v1:subscribe(function(p1, p2)
 v2 = v1:subscribe(v3.value)
 end)
 expect(v3.callCount).to.equal(0)
 local t = {}
 v1:fire(t, 67)
 expect(v3.callCount).to.equal(0)
 v1:fire(67, t)
 expect(v3.callCount).to.equal(1)
 v3:assertCalledWith(67, t)
 v2()
 v4()
 v1:fire(t)
 expect(v3.callCount).to.equal(1)
	end)
	it("should have one connection instance when add the same listener multiple times", function()
 local v1 = createSignal()
 local v2 = createSpy()
 local v3 = v1:subscribe(v2.value)
 expect(v2.callCount).to.equal(0)
 local t = {}
 v1:fire(t, 67)
 expect(v2.callCount).to.equal(1)
 v2:assertCalledWith(t, 67)
 local v4 = v1:subscribe(v2.value)
 v1:fire(67, t)
 expect(v2.callCount).to.equal(2)
 v2:assertCalledWith(67, t)
 v4()
 v1:fire(t)
 expect(v2.callCount).to.equal(2)
 v3()
 v1:fire(t)
 expect(v2.callCount).to.equal(2)
	end)
end