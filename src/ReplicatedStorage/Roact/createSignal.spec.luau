-- Reviewed by Claude
-- variables reassigned
return function()
	local createSignal = require(script.Parent.createSignal)
	local createSpy = require(script.Parent.createSpy)
	it("should fire subscribers and disconnect them", function()
 local state1 = createSignal()
 local state2 = createSpy()
 local newState = state1:subscribe(state2.value)
 expect(state2.callCount).to.equal(0)
 local tableObj = {}
 state1:fire(1, tableObj, "hello")
 expect(state2.callCount).to.equal(1)
 state2:assertCalledWith(1, tableObj, "hello")
 newState()
 state1:fire()
 expect(state2.callCount).to.equal(1)
	end)
	it("should handle multiple subscribers", function()
 local state1 = createSignal()
 local state2 = createSpy()
 local newState = createSpy()
 local fn = state1:subscribe(state2.value)
 local fn2 = state1:subscribe(newState.value)
 expect(state2.callCount).to.equal(0)
 expect(newState.callCount).to.equal(0)
 local tableObj = {}
 state1:fire(tableObj, 67)
 expect(state2.callCount).to.equal(1)
 state2:assertCalledWith(tableObj, 67)
 expect(newState.callCount).to.equal(1)
 newState:assertCalledWith(tableObj, 67)
 fn()
 state1:fire(67, tableObj)
 expect(state2.callCount).to.equal(1)
 expect(newState.callCount).to.equal(2)
 newState:assertCalledWith(67, tableObj)
 fn2()
	end)
	it("should stop firing a connection if disconnected mid-fire", function()
 local state1 = createSignal()
 local state2 = nil
 local newState = nil
 local fn = createSpy(function()
 newState()
 end)
 local fn2 = createSpy(function()
 state2()
 end)
 state2 = state1:subscribe(fn.value)
 newState = state1:subscribe(fn2.value)
 state1:fire()
 expect(fn.callCount + fn2.callCount).to.equal(1)
	end)
	it("should allow adding listener in the middle of firing", function()
 local state1 = createSignal()
 local state2 = nil
 local newState = createSpy()
 local fn = state1:subscribe(function(self, callback)
 state2 = state1:subscribe(newState.value)
 end)
 expect(newState.callCount).to.equal(0)
 local tableObj = {}
 state1:fire(tableObj, 67)
 expect(newState.callCount).to.equal(0)
 state1:fire(67, tableObj)
 expect(newState.callCount).to.equal(1)
 newState:assertCalledWith(67, tableObj)
 state2()
 fn()
 state1:fire(tableObj)
 expect(newState.callCount).to.equal(1)
	end)
	it("should have one connection instance when add the same listener multiple times", function()
 local state1 = createSignal()
 local state2 = createSpy()
 local newState = state1:subscribe(state2.value)
 expect(state2.callCount).to.equal(0)
 local tableObj = {}
 state1:fire(tableObj, 67)
 expect(state2.callCount).to.equal(1)
 state2:assertCalledWith(tableObj, 67)
 local fn = state1:subscribe(state2.value)
 state1:fire(67, tableObj)
 expect(state2.callCount).to.equal(2)
 state2:assertCalledWith(67, tableObj)
 fn()
 state1:fire(tableObj)
 expect(state2.callCount).to.equal(2)
 newState()
 state1:fire(tableObj)
 expect(state2.callCount).to.equal(2)
	end)
end
