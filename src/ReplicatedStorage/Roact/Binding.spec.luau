-- Reviewed by Claude
-- variables reassigned
return function()
	local createSpy = require(script.Parent.createSpy)
	local Type = require(script.Parent.Type)
	local GlobalConfig = require(script.Parent.GlobalConfig)
	local Binding = require(script.Parent.Binding)
	describe("Binding.create", function()
		it("should return a Binding object and an update function", function()
			local fn3, fn4 = Binding.create(1)
			expect(Type.of(fn3)).to.equal(Type.Binding)
			expect((typeof(fn4))).to.equal("function")
		end)
		it("should support tostring on bindings", function()
			local fn3, fn4 = Binding.create(1)
			expect((tostring(fn3))).to.equal("RoactBinding(1)")
			fn4("foo")
			expect((tostring(fn3))).to.equal("RoactBinding(foo)")
		end)
	end)
	describe("Binding object", function()
		it("should provide a getter and setter", function()
			local fn3, fn4 = Binding.create(1)
			expect(fn3:getValue()).to.equal(1)
			fn4(3)
			expect(fn3:getValue()).to.equal(3)
		end)
		it("should let users subscribe and unsubscribe to its updates", function()
			local fn3, fn4 = Binding.create(1)
			local newState = createSpy()
			local fn = Binding.subscribe(fn3, newState.value)
			expect(newState.callCount).to.equal(0)
			fn4(2)
			expect(newState.callCount).to.equal(1)
			newState:assertCalledWith(2)
			fn()
			fn4(3)
			expect(newState.callCount).to.equal(1)
		end)
	end)
	describe("Mapped bindings", function()
		it("should be composable", function()
			local fn3, fn4 = Binding.create("hi")
			local newState = fn3:map(string.len)
			local fn = newState:map(function(self)
				return self % 2 == 0
			end)
			expect(fn3:getValue()).to.equal("hi")
			expect(newState:getValue()).to.equal(2)
			expect(fn:getValue()).to.equal(true)
			fn4("sup")
			expect(fn3:getValue()).to.equal("sup")
			expect(newState:getValue()).to.equal(3)
			expect(fn:getValue()).to.equal(false)
		end)
		it("should cascade updates when subscribed", function()
			local fn3, fn4 = Binding.create("hi")
			local newState = createSpy()
			local fn = Binding.subscribe(fn3, newState.value)
			local nextState = fn3:map(string.len)
			local tempState = createSpy()
			local mergedState = Binding.subscribe(nextState, tempState.value)
			local fn2 = nextState:map(function(self)
				return self % 2 == 0
			end)
			local finalState = createSpy()
			local var10 = Binding.subscribe(fn2, finalState.value)
			expect(newState.callCount).to.equal(0)
			expect(tempState.callCount).to.equal(0)
			expect(finalState.callCount).to.equal(0)
			fn4("nice")
			expect(newState.callCount).to.equal(1)
			newState:assertCalledWith("nice")
			expect(tempState.callCount).to.equal(1)
			tempState:assertCalledWith(4)
			expect(finalState.callCount).to.equal(1)
			finalState:assertCalledWith(true)
			fn()
			mergedState()
			var10()
			fn4("goodbye")
			expect(newState.callCount).to.equal(1)
			expect(finalState.callCount).to.equal(1)
			expect(tempState.callCount).to.equal(1)
		end)
		it("should throw when updated directly", function()
			local fn3 = Binding.create(1):map(function(self)
				return self
			end)
			expect(function()
				Binding.update(fn3, 5)
			end).to.throw()
		end)
	end)
	describe("Binding.join", function()
		it("should have getValue", function()
			local fn3 = Binding.create(1)
			local fn4 = Binding.create(2)
			local fn = Binding.join({
				fn3,
				fn4,
				foo = Binding.create(3)
			}):getValue()
			expect(fn).to.be.a("table")
			expect(fn[1]).to.equal(1)
			expect(fn[2]).to.equal(2)
			expect(fn.foo).to.equal(3)
		end)
		it("should update when any one of the subscribed bindings updates", function()
			local fn3, fn4 = Binding.create(1)
			local newState, fn = Binding.create(2)
			local nextState, tempState = Binding.create(3)
			local mergedState = Binding.join({
				fn3,
				newState,
				foo = nextState
			})
			local fn2 = createSpy()
			Binding.subscribe(mergedState, fn2.value)
			expect(fn2.callCount).to.equal(0)
			fn4(3)
			expect(fn2.callCount).to.equal(1)
			local finalState = fn2:captureValues("value")
			expect(finalState.value).to.be.a("table")
			expect(finalState.value[1]).to.equal(3)
			expect(finalState.value[2]).to.equal(2)
			expect(finalState.value.foo).to.equal(3)
			fn(4)
			expect(fn2.callCount).to.equal(2)
			local var10 = fn2:captureValues("value")
			expect(var10.value).to.be.a("table")
			expect(var10.value[1]).to.equal(3)
			expect(var10.value[2]).to.equal(4)
			expect(var10.value.foo).to.equal(3)
			tempState(8)
			expect(fn2.callCount).to.equal(3)
			local var11 = fn2:captureValues("value")
			expect(var11.value).to.be.a("table")
			expect(var11.value[1]).to.equal(3)
			expect(var11.value[2]).to.equal(4)
			expect(var11.value.foo).to.equal(8)
		end)
		it("should disconnect from all upstream bindings", function()
			local fn3, fn4 = Binding.create(1)
			local newState, fn = Binding.create(2)
			local nextState = Binding.join({ fn3, newState })
			local tempState = createSpy()
			local mergedState = Binding.subscribe(nextState, tempState.value)
			expect(tempState.callCount).to.equal(0)
			fn4(3)
			expect(tempState.callCount).to.equal(1)
			fn(3)
			expect(tempState.callCount).to.equal(2)
			mergedState()
			fn4(4)
			expect(tempState.callCount).to.equal(2)
			fn(2)
			expect(tempState.callCount).to.equal(2)
			local fn2 = nextState:getValue()
			expect(fn2[1]).to.equal(4)
			expect(fn2[2]).to.equal(2)
		end)
		it("should be okay with calling disconnect multiple times", function()
			local fn4 = Binding.subscribe(Binding.join({}), function()  end)
			fn4()
			fn4()
		end)
		it("should throw if updated directly", function()
			local fn3 = Binding.join({})
			expect(function()
				Binding.update(fn3, 0)
			end)
		end)
		it("should throw when a non-table value is passed", function()
			GlobalConfig.scoped({
				typeChecks = true
			}, function()
				expect(function()
					Binding.join("hi")
				end).to.throw()
			end)
		end)
		it("should throw when a non-binding value is passed via table", function()
			GlobalConfig.scoped({
				typeChecks = true
			}, function()
				expect(function()
					Binding.join({ Binding.create(123), "abcde" })
				end).to.throw()
			end)
		end)
	end)
end
