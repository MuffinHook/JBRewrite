-- Reviewed by Claude
return function()
	local createSpy = require(script.Parent.createSpy)
	local Type = require(script.Parent.Type)
	local GlobalConfig = require(script.Parent.GlobalConfig)
	local Binding = require(script.Parent.Binding)
	describe("Binding.create", function()
		it("should return a Binding object and an update function", function()
			local fn3, fn4 = Binding.create(1)
			expect(Type.of(fn3)).to.equal(Type.Binding)
			expect((typeof(fn4))).to.equal("function")
		end)
		it("should support tostring on bindings", function()
			local fn3, fn4 = Binding.create(1)
			expect((tostring(fn3))).to.equal("RoactBinding(1)")
			fn4("foo")
			expect((tostring(fn3))).to.equal("RoactBinding(foo)")
		end)
	end)
	describe("Binding object", function()
		it("should provide a getter and setter", function()
			local fn3, fn4 = Binding.create(1)
			expect(fn3:getValue()).to.equal(1)
			fn4(3)
			expect(fn3:getValue()).to.equal(3)
		end)
		it("should let users subscribe and unsubscribe to its updates", function()
			local fn3, fn4 = Binding.create(1)
			local v3 = createSpy()
			local fn = Binding.subscribe(fn3, v3.value)
			expect(v3.callCount).to.equal(0)
			fn4(2)
			expect(v3.callCount).to.equal(1)
			v3:assertCalledWith(2)
			fn()
			fn4(3)
			expect(v3.callCount).to.equal(1)
		end)
	end)
	describe("Mapped bindings", function()
		it("should be composable", function()
			local fn3, fn4 = Binding.create("hi")
			local v3 = fn3:map(string.len)
			local fn = v3:map(function(p1)
				return p1 % 2 == 0
			end)
			expect(fn3:getValue()).to.equal("hi")
			expect(v3:getValue()).to.equal(2)
			expect(fn:getValue()).to.equal(true)
			fn4("sup")
			expect(fn3:getValue()).to.equal("sup")
			expect(v3:getValue()).to.equal(3)
			expect(fn:getValue()).to.equal(false)
		end)
		it("should cascade updates when subscribed", function()
			local fn3, fn4 = Binding.create("hi")
			local v3 = createSpy()
			local fn = Binding.subscribe(fn3, v3.value)
			local v5 = fn3:map(string.len)
			local v6 = createSpy()
			local v7 = Binding.subscribe(v5, v6.value)
			local fn2 = v5:map(function(p1)
				return p1 % 2 == 0
			end)
			local v9 = createSpy()
			local v10 = Binding.subscribe(fn2, v9.value)
			expect(v3.callCount).to.equal(0)
			expect(v6.callCount).to.equal(0)
			expect(v9.callCount).to.equal(0)
			fn4("nice")
			expect(v3.callCount).to.equal(1)
			v3:assertCalledWith("nice")
			expect(v6.callCount).to.equal(1)
			v6:assertCalledWith(4)
			expect(v9.callCount).to.equal(1)
			v9:assertCalledWith(true)
			fn()
			v7()
			v10()
			fn4("goodbye")
			expect(v3.callCount).to.equal(1)
			expect(v9.callCount).to.equal(1)
			expect(v6.callCount).to.equal(1)
		end)
		it("should throw when updated directly", function()
			local fn3 = Binding.create(1):map(function(p1)
				return p1
			end)
			expect(function()
				Binding.update(fn3, 5)
			end).to.throw()
		end)
	end)
	describe("Binding.join", function()
		it("should have getValue", function()
			local fn3 = Binding.create(1)
			local fn4 = Binding.create(2)
			local fn = Binding.join({
				fn3,
				fn4,
				foo = Binding.create(3)
			}):getValue()
			expect(fn).to.be.a("table")
			expect(fn[1]).to.equal(1)
			expect(fn[2]).to.equal(2)
			expect(fn.foo).to.equal(3)
		end)
		it("should update when any one of the subscribed bindings updates", function()
			local fn3, fn4 = Binding.create(1)
			local v3, fn = Binding.create(2)
			local v5, v6 = Binding.create(3)
			local v7 = Binding.join({
				fn3,
				v3,
				foo = v5
			})
			local fn2 = createSpy()
			Binding.subscribe(v7, fn2.value)
			expect(fn2.callCount).to.equal(0)
			fn4(3)
			expect(fn2.callCount).to.equal(1)
			local v9 = fn2:captureValues("value")
			expect(v9.value).to.be.a("table")
			expect(v9.value[1]).to.equal(3)
			expect(v9.value[2]).to.equal(2)
			expect(v9.value.foo).to.equal(3)
			fn(4)
			expect(fn2.callCount).to.equal(2)
			local v10 = fn2:captureValues("value")
			expect(v10.value).to.be.a("table")
			expect(v10.value[1]).to.equal(3)
			expect(v10.value[2]).to.equal(4)
			expect(v10.value.foo).to.equal(3)
			v6(8)
			expect(fn2.callCount).to.equal(3)
			local v11 = fn2:captureValues("value")
			expect(v11.value).to.be.a("table")
			expect(v11.value[1]).to.equal(3)
			expect(v11.value[2]).to.equal(4)
			expect(v11.value.foo).to.equal(8)
		end)
		it("should disconnect from all upstream bindings", function()
			local fn3, fn4 = Binding.create(1)
			local v3, fn = Binding.create(2)
			local v5 = Binding.join({ fn3, v3 })
			local v6 = createSpy()
			local v7 = Binding.subscribe(v5, v6.value)
			expect(v6.callCount).to.equal(0)
			fn4(3)
			expect(v6.callCount).to.equal(1)
			fn(3)
			expect(v6.callCount).to.equal(2)
			v7()
			fn4(4)
			expect(v6.callCount).to.equal(2)
			fn(2)
			expect(v6.callCount).to.equal(2)
			local fn2 = v5:getValue()
			expect(fn2[1]).to.equal(4)
			expect(fn2[2]).to.equal(2)
		end)
		it("should be okay with calling disconnect multiple times", function()
			local fn4 = Binding.subscribe(Binding.join({}), function()  end)
			fn4()
			fn4()
		end)
		it("should throw if updated directly", function()
			local fn3 = Binding.join({})
			expect(function()
				Binding.update(fn3, 0)
			end)
		end)
		it("should throw when a non-table value is passed", function()
			GlobalConfig.scoped({
				typeChecks = true
			}, function()
				expect(function()
					Binding.join("hi")
				end).to.throw()
			end)
		end)
		it("should throw when a non-binding value is passed via table", function()
			GlobalConfig.scoped({
				typeChecks = true
			}, function()
				expect(function()
					Binding.join({ Binding.create(123), "abcde" })
				end).to.throw()
			end)
		end)
	end)
end
